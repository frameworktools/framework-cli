# settings.yml: settings that fw, R, Python, and Stata share
#
# settings.do holds the path globals that do-files use, such as $inputs_raw.
# This file holds the project name, the data catalog for fw_use and fw_save,
# the publishing destinations for fw_publish, and the security settings.
# Framework for Stata (fw_project) reads both files. The directories below
# match settings.do. When the two set a folder differently, this file wins
# and fw_project notes it, so change a folder in both.
default:
  project_name: {{yaml .Name}}
  directories:{{if not .Globals}} {}{{end}}
{{- range .Globals}}
    {{.Name}}: {{yaml .Path}}
{{- end}}

  # The data catalog. fw_use and fw_save take a catalog name in place of a
  # path, such as {{.CatalogName}}.survey, and check the file's checksum when
  # the entry is locked:
  #
  #   data:
{{- range $i, $k := .CatalogKeys}}
  #   {{indent $i}}  {{$k}}:
{{- end}}
  #   {{indent (len .CatalogKeys)}}  survey:
  #   {{indent (len .CatalogKeys)}}    path: {{.CatalogPath}}/survey.csv
  #   {{indent (len .CatalogKeys)}}    locked: true
  data: {}
{{- if .Sensitive}}

  # This project holds restricted data: fw_table and fw_graph save to the
  # private folders unless told public.
  security:
    sensitive: true
{{- end}}
{{- if .Publish}}

{{.Publish}}
{{- else}}

  # Publishing destinations for fw_publish, to(NAME). A folder destination
  # writes each result, with its versions and an offline reader, under path:
  #
  #   publish:
  #     default: results
  #     destinations:
  #       results:
  #         driver: folder
  #         path: published
  #         visibility: private
{{- end}}
