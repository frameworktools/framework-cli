# Framework Stata project
# As in R and Python projects, git ignores data by folder, not by file type:
# everything under a private/ folder stays out of git, and so do logs, cache,
# scratch, and tmp folders. Data in other folders, such as a public .dta,
# can be committed. Put data that must stay on this machine under private/.
{{- if .Sensitive}}
#
# This project holds restricted data. Everything under a private/ folder stays
# on the machine that may hold it. Only reviewed, de-identified files go in
# public/ folders.
{{- end}}

# Stata logs and session files
*.log
*.smcl
*.stswp
{{- if .Sensitive}}

# Restricted data
/inputs/private/
/outputs/private/
**/private/**
**/*_private/**
**/sensitive/**

# Keep the folder structure and its documentation
!/inputs/**/README.md
!/inputs/**/.gitkeep
!/outputs/**/README.md
!/outputs/**/.gitkeep
{{- else}}

# Private data, anywhere in the project
**/private/**
**/*_private/**
{{- end}}

# Secrets and credentials
.env
.env.*
!.env.example
**/credentials/**
**/secrets/**
*.key
*.pem
{{- if .Sensitive}}
*.p12
*.pfx
{{- end}}

# Logs, cache, and scratch work
**/logs/**
**/cache/**
**/scratch/**
**/tmp/**
slurm-*.out

# System files
.DS_Store
Thumbs.db
*~
*.tmp
*.bak
